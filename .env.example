# Copie para .env.local e preencha os valores

# URL pública (SEO, sitemap e robots.txt). Em produção: https://hammergold.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de contato (uso futuro)
CONTACT_EMAIL=

# Chave API do GroqCloud (https://console.groq.com/keys) — Apenas servidor (sem NEXT_PUBLIC_)
GROQ_API_KEY=

# Modelo de IA (GroqCloud). Recomendado: llama-3.3-70b-versatile
# Outros: llama-3.1-8b-instant, qwen-2.5-32b, deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile