# Hammer Gold — Environment Variables
# Copy this file to .env.local and fill in values

# Canonical public URL used in metadata, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email (future use)
CONTACT_EMAIL=

# GroqCloud — create a free key at https://console.groq.com/keys
# Keep this value server-side. Never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional. Recommended default: llama-3.3-70b-versatile
# Other valid options: llama-3.1-8b-instant, qwen-2.5-32b, deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile
